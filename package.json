{
  "name": "code-visualizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 node scripts/start.mjs dev",
    "build": "npm run worker:build && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 node scripts/start.mjs start",
    "worker:build": "node scripts/build-workers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run worker:build && tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "npm run worker:build && tsx scripts/benchmark.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "elkjs": "0.12.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13"
  }
}
