{
  "name": "cvis",
  "version": "0.1.0",
  "description": "Explore TypeScript calls and declarations in your terminal",
  "type": "module",
  "bin": {
    "cvis": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build --silent && node dist/cli.js",
    "build": "tsc -p tsconfig.build.json && node scripts/executable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "clipboardy": "^5.3.2",
    "ink": "7.1.1",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "string-width": "^8.2.2",
    "typescript": "5.9.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13"
  }
}
